# Stuviora environment template.
#
# Copy this file to `.env.local` and fill in real values to switch the app
# from DEMO_MODE to live data. Every integration is independent: set only
# Supabase and the app reads/writes a real database while the rest stay on
# the demo fallback. The flags are derived in lib/env.ts.
#
# NEVER commit .env.local. Service-role and secret keys are admin-grade.
# In production, set these in your host (e.g. Vercel) env, not in the repo.

# --- App ---------------------------------------------------------------
# Public base URL. Used in emails, OAuth redirects, sitemap.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Random 32+ char string. Signs the demo session cookie. Change in prod.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Supabase (P1+: database, auth, storage) ---------------------------
# THE critical one. Without it the whole app stays in DEMO_MODE.
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
# Public client key. Use EITHER the legacy JWT anon key here, OR the new
# `sb_publishable_...` key via NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY below.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # new-format alternative to anon key
# Service role key: server-only, bypasses RLS. Treat like a root password.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay Route (P3+: escrow payments + 85/15 split) ---------------
# Requires an activated Razorpay account with Route enabled (KYC + approval).
# Use TEST keys (rzp_test_...) until you have run a Rs.100 live test.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when you create the webhook; used to verify webhook signatures.
RAZORPAY_WEBHOOK_SECRET=

# --- LLM (P4+: AI quality gate, proposal writer) -----------------------
# Groq is the sole provider (open-weight models, OpenAI-compatible).
# The admin picks the tier in /admin/ops; the UI shows the real model id.
GROQ_API_KEY=
# Optional per-tier model overrides (defaults shown in lib/env.ts; confirm
# current ids at console.groq.com/docs/models).
# GROQ_MODEL_FAST=llama-3.1-8b-instant
# GROQ_MODEL_BALANCED=llama-3.3-70b-versatile
# GROQ_MODEL_MAX=meta-llama/llama-4-maverick-17b-128e-instruct

# --- Resend (P5+: transactional + retention email) ---------------------
RESEND_API_KEY=
# Must be a verified sending domain in Resend.
RESEND_FROM=Stuviora <noreply@yourdomain.com>

# --- Inngest (P4+: background jobs, fan-out, crons) --------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Upstash Redis (P6: rate limiting) ---------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Meilisearch (P6: search) ------------------------------------------
MEILISEARCH_HOST=
MEILISEARCH_KEY=

# --- Observability (P6) ------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
